# --- Jupyter Notebook の一時キャッシュファイルを無視 ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/
__pycache__/
*.pyc

# --- OSが自動作成する不要なシステムファイルを無視 ---
.DS_Store
Thumbs.db
desktop.ini
*.Zone.Identifier

# --- ユーザー指定により研究原本も保存。認証情報・一時ファイルは別途除外 ---
# Windows download metadata
*:Zone.Identifier

# Local tool/config directories
.agents/
.aws/
.codex/
.venv/
hardware/camera/.connection/


# Research software and presentation history remain local.
**/backups/
results/**/previous_analysis/
~$*

# Presentation documents, previews and generation files stay local only.
presentations/
data/raw/PowerPoint/
*.pptx
*.ppt
*.potx
*.pptm
*.ppsx
