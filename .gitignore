# --- Jupyter Notebook の一時キャッシュファイルを無視 ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/
__pycache__/
*.pyc

# --- OSが自動作成する不要なシステムファイルを無視 ---
.DS_Store
Thumbs.db
desktop.ini
*.Zone.Identifier

# --- 大容量の実験用オリジナル画像（rawデータ）はGitの追跡から除外する ---
data/raw/
# Windows download metadata
*:Zone.Identifier

# Local tool/config directories
.agents/
.aws/
.codex/
.venv/

# Keep the current presentation; retain intermediate decks/backups locally only.
presentations/20261015/*.pptx
!presentations/20261015/M1_10_15_全体.pptx
